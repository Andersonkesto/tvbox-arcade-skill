# Keylayout for My-Power / GreenAsia PS(R) Controller Adaptor (0e8f:0003)

key 288   BUTTON_Y
key 289   BUTTON_B
key 290   BUTTON_A
key 291   BUTTON_X
key 292   BUTTON_L1
key 293   BUTTON_R1
key 294   BUTTON_L2
key 295   BUTTON_R2
key 296   BUTTON_SELECT
key 297   BUTTON_START
key 298   BUTTON_THUMBL
key 299   BUTTON_THUMBR

# Left Analog Stick
axis 0x00 X
axis 0x01 Y

# Right Analog Stick
axis 0x02 Z
axis 0x05 RZ

# D-Pad (HAT)
axis 0x10 HAT_X
axis 0x11 HAT_Y
